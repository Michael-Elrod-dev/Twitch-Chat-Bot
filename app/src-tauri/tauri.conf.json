{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlmostHadAI",
  "version": "0.1.0",
  "identifier": "ai.almosthad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#171614"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' http://127.0.0.1:3000 http://localhost:3000 https: wss:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["almosthadai"]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/Michael-Elrod-dev/Twitch-Chat-Bot/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
