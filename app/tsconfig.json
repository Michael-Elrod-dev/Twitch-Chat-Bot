{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    /*
     * Bundler resolution rather than the repo's NodeNext: Vite resolves the
     * imports here, and NodeNext would demand `.js` suffixes on TSX imports
     * that the bundler never sees. The strictness below is the part that must
     * match the rest of the repo, and does.
     */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"]
}
