# AlmostHadAI — Phase 1 server configuration
#
# Copy to .env and fill in. NEVER commit the real file; .env is gitignored.
#
# The server validates all of this at boot and reports every problem at once,
# so a misconfigured deployment fails immediately with a readable list rather
# than at 3am with `undefined` in a connection string.

# ---- Core ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://almosthadai_app:devpassword@localhost:5432/almosthadai
REDIS_URL=redis://localhost:6379

# Pool size. Tuned here, never assumed at call sites.
DATABASE_POOL_MAX=10

# ---- Public address --------------------------------------------------------
#
# The origin Twitch reaches this server at. MUST be https in production: Twitch
# will not deliver EventSub webhooks to a non-TLS callback, and refuses any port
# other than 443.
#
# Local development leaves this unset and drives the webhook with signed
# synthetic events (see README, "Feeding the bot events locally").
#PUBLIC_URL=https://bot.example.duckdns.org

# ---- Token encryption ------------------------------------------------------
#
# 32 bytes, base64 or hex. Every OAuth token is AES-256-GCM encrypted at rest
# with this key. REQUIRED in production — the server refuses to boot without it.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Losing this key means every stored token becomes undecryptable and every
# channel must reconnect. Back it up somewhere other than this machine.
TOKEN_ENCRYPTION_KEY=

# ---- Twitch application ----------------------------------------------------
#
# From https://dev.twitch.tv/console/apps. Register one application and set its
# OAuth Redirect URL to exactly:
#
#   http://localhost:3000/auth/twitch/callback     (local)
#   https://<your-public-host>/auth/twitch/callback (deployed)
#
# One client id serves everything: the desktop app is never an OAuth client of
# Twitch's, it signs in through this server (PKCE does not exist at Twitch,
# see docs/TWITCH_PLATFORM_FACTS.md section 5.2).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Signs the webhook HMAC. 10–100 ASCII characters. Must match what the
# subscriptions were created with, so changing it means re-subscribing.
# Production refuses to start on the committed development default.
TWITCH_EVENTSUB_SECRET=

# ---- EventSub behaviour ----------------------------------------------------

# Subscription reconciliation computes and logs its diff but changes nothing
# while this is true. Set false only once the credentials above are real and
# PUBLIC_URL points somewhere Twitch can reach.
EVENTSUB_DRY_RUN=true

# Replay window for webhook deliveries. Twitch's documented figure is 10
# minutes; a retry carries the ORIGINAL timestamp, so a tighter window would
# reject exactly the redeliveries the retry policy exists to make.
EVENTSUB_MAX_SKEW_SECONDS=600

# Spacing between subscription creates, under Twitch's 100/minute limit.
EVENTSUB_CREATE_SPACING_MS=750

# How often subscriptions are reconciled in the background, in milliseconds.
# 0 turns it off. This is the safety net under the event-driven reconciliation:
# if a channel is enabled while the creates fail, it would otherwise sit running
# with no subscriptions - on, and silent - until something else changed.
EVENTSUB_RECONCILE_INTERVAL_MS=900000

# ---- App sessions ----------------------------------------------------------
#
# Signs this server's OWN session tokens — unrelated to Twitch. At least 32
# characters. Rotating it signs every user out, which is the intended way to
# revoke everything at once.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Access-token lifetime in seconds. Short by design: the refresh token is what
# provides continuity, and it can be revoked.
JWT_TTL_SECONDS=900

# ---- Bot identity ----------------------------------------------------------
#
# Normally populated by the bot account visiting /auth/bot/connect, which is the
# authoritative source. This is the escape hatch for a deployment that has not
# been through that yet.
#BOT_TWITCH_USER_ID=

# Comma-separated names the AI answers to. Defaults to the bot's own login.
#AI_TRIGGERS=almosthadai

# ---- Spotify ---------------------------------------------------------------
#
# From https://developer.spotify.com/dashboard. Redirect URI must be exactly:
#   https://<your-public-host>/auth/spotify/callback
#
# NOTE: Development Mode requires the app owner to hold Spotify Premium, allows
# 5 users per app, and every user must be allowlisted in the dashboard
# (Settings -> User Management). A broadcaster who is not allowlisted cannot
# connect, and the failure is not self-explanatory.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- API v1 ----------------------------------------------------------------
#
# Per-principal sliding window. Generous by design: this is a single-user
# desktop app talking to its own server, so the limit exists to bound a runaway
# client or a leaked key, not to ration normal use.
API_RATE_WINDOW_MS=60000
API_RATE_MAX=300

# ---- Compose only ----------------------------------------------------------
#
# Read by docker-compose.yml, not by the server itself.
POSTGRES_PASSWORD=devpassword

# Password for the least-privilege runtime role. Production must not use the
# development default; the init script refuses to create the role without this.
APP_DB_PASSWORD=devpassword

# Public hostname for Caddy. Unset locally (plain :80); set in production, which
# is what makes Caddy obtain a Let's Encrypt certificate.
#SITE_ADDRESS=almosthadai.duckdns.org

# Credentials used ONLY for migrations, which need table ownership the runtime
# role deliberately does not have.
#MIGRATION_DATABASE_URL=postgres://almosthadai:...@localhost:5432/almosthadai
#SERVER_PORT=3000
#HTTP_PORT=8080
#HTTPS_PORT=8443
