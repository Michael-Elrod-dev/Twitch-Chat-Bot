{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "timezone": "America/New_York",
  "schedule": [
    "before 9am on monday"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "All non-major updates arrive as one weekly PR - CI green is the review signal.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "description": "Majors get their own PR each - they need reading, not just a green tick.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "schedule": [
        "before 9am on monday"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on the first day of the month"
    ],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": null
  },
  "automerge": false,
  "major": {
    "automerge": false
  },
  "minor": {
    "automerge": false
  },
  "patch": {
    "automerge": false
  }
}
