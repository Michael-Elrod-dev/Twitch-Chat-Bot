{
  "name": "almosthadai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "app"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run dev -w server",
    "typecheck": "tsc -b --pretty && tsc -p server/tsconfig.scripts.json && tsc -p app/tsconfig.json",
    "test:server": "npm run test -w server",
    "test:app": "npm run test -w @almosthadai/app",
    "lint": "eslint .",
    "test": "npm run test -w server && npm run test -w @almosthadai/app"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "author": "",
  "license": "ISC",
  "description": "AlmostHadAI - multi-tenant Twitch bot (npm workspaces: shared, server)"
}
