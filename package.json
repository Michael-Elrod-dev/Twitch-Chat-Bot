{
  "name": "almosthadai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server"
  ],
  "main": "src/bot.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/bot.js",
    "debug": "node src/bot.js --debug",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "build": "tsc -b",
    "dev": "npm run dev -w server",
    "typecheck": "tsc -b --pretty && tsc -p server/tsconfig.scripts.json",
    "test:server": "npm run test -w server",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.980.0",
    "dotenv": "16.5.0",
    "express": "4.22.1",
    "ioredis": "5.9.2",
    "mysql2": "3.12.0",
    "node-fetch": "2.7.0",
    "spotify-web-api-node": "5.0.2",
    "winston": "3.18.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "4.17.23",
    "@types/jest": "29.5.14",
    "@types/node": "26.2.0",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
