{
  "name": "@almosthadai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev:event": "tsx scripts/send-test-event.ts",
    "db:encrypt-tokens": "tsx scripts/encrypt-tokens.ts"
  },
  "dependencies": {
    "@almosthadai/shared": "*",
    "@anthropic-ai/sdk": "0.117.1",
    "drizzle-orm": "^0.45.2",
    "express": "4.22.1",
    "ioredis": "^5.9.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "^3.4.9",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "mysql2": "^3.12.0",
    "supertest": "7.2.2"
  }
}
